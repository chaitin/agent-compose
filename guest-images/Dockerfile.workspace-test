# File-delivery E2E guest: real JavaScript runtime, no provider CLI or model calls.
FROM node:22-bookworm-slim AS build
WORKDIR /opt/agent-compose-runtime
COPY runtime/javascript/package.json runtime/javascript/package-lock.json ./
RUN npm ci --omit=optional --ignore-scripts
COPY runtime/javascript/tsconfig.json ./
COPY runtime/javascript/src ./src
RUN npm run build && npm prune --omit=dev --omit=optional --ignore-scripts

FROM node:22-bookworm-slim
ARG REVISION=unknown
LABEL org.opencontainers.image.revision="${REVISION}"
WORKDIR /opt/agent-compose-runtime
COPY --from=build /opt/agent-compose-runtime/package.json ./
COPY --from=build /opt/agent-compose-runtime/node_modules ./node_modules
COPY --from=build /opt/agent-compose-runtime/dist ./dist
RUN ln -s /opt/agent-compose-runtime/dist/cli.js /usr/local/bin/agent-compose-runtime && chmod +x dist/cli.js && mkdir -p /workspace /data/state /data/runtime /data/logs /root/.codex /root/.local/bin
WORKDIR /workspace
CMD ["sh", "-c", "sleep infinity"]
