ARG REGISTRY_MIRROR=docker.io
ARG GOPROXY=https://proxy.golang.org,direct
ARG GO_VERSION=1.26.7
ARG GRPCURL_VERSION=v1.9.3
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_TRUSTED_HOST
ARG NPM_CONFIG_REGISTRY=https://registry.npmjs.org
ARG NODE_MAJOR=22
ARG CODEX_VERSION=0.146.0
ARG CLAUDE_CODE_VERSION=2.1.220
ARG OPENCODE_VERSION=1.18.9
ARG PI_AGENT_VERSION=0.82.1
ARG PI_MCP_ADAPTER_VERSION=2.11.0
# @deepseek-ai/dsh-root's engines is ^22.19.0 || >=24.0.0 — keep NODE_MAJOR at
# or above that when bumping DSH_VERSION. The agent-compose profile's runner
# uses the DSH persona-prefix API (0.1.5+) and the build-time profile smoke
# below needs `--dump-config-schema` (0.1.7+), so older pins no longer build.
# The smoke also boots the profile for real, because `--dump-config-schema` only
# imports the entries: a runner whose injected services are missing still renders
# its Config schema there and would pass. A real boot activates the runner only
# once those services resolve, and an activated runner creates a session, which
# is what the smoke asserts. The boot passes DSH_SYSTEM_CONTEXT_FILE because the
# runner returns early from injectPersona without it, which would leave the
# persona-prefix calls this image is pinned for unexecuted; and since the session
# is created before injectPersona runs, the session check alone cannot see a
# failure there, so the boot also asserts the runner logged no error of its own.
# The boot's `|| true` stays scoped inside its own
# `{ ...; }` group: a trailing `|| true` on the `&&` chain would swallow a failure
# from any earlier step and misreport it as an inactive runner.
ARG DSH_VERSION=0.2.0-rc.1

FROM ${REGISTRY_MIRROR}/library/golang:${GO_VERSION}-alpine AS grpcurl-builder
ARG GOPROXY
ARG GRPCURL_VERSION

RUN CGO_ENABLED=0 \
    GOBIN=/out \
    GOPROXY="${GOPROXY}" \
    go install github.com/fullstorydev/grpcurl/cmd/grpcurl@"${GRPCURL_VERSION}"

FROM ${REGISTRY_MIRROR}/library/debian:bookworm-slim
ARG PIP_INDEX_URL
ARG PIP_TRUSTED_HOST
ARG NPM_CONFIG_REGISTRY
ARG NODE_MAJOR
ARG CODEX_VERSION
ARG CLAUDE_CODE_VERSION
ARG OPENCODE_VERSION
ARG PI_AGENT_VERSION
ARG PI_MCP_ADAPTER_VERSION
ARG DSH_VERSION
ARG TARGETARCH

COPY --from=grpcurl-builder /out/grpcurl /usr/local/bin/grpcurl

RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 python3-pip git curl ca-certificates tini gnupg build-essential pkg-config protobuf-compiler && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" > /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends nodejs && \
    npm config set registry "${NPM_CONFIG_REGISTRY}" --global && \
    npm config set fund false --global && \
    npm config set update-notifier false --global && \
    apt-get purge -y --auto-remove gnupg dirmngr && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /root/.npm /root/.cache

ENV PIP_INDEX_URL=${PIP_INDEX_URL}
ENV PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST}
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

RUN PIP_REQUIRE_HASHES=0 python3 -m pip install --break-system-packages --no-cache-dir --no-input \
    jupyterlab bash_kernel && \
    python3 -m bash_kernel.install --sys-prefix

RUN set -e; \
    target_arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "${target_arch}" in \
      amd64) CLAUDE_CODE_PLATFORM_PACKAGE=@anthropic-ai/claude-code-linux-x64 ;; \
      arm64) CLAUDE_CODE_PLATFORM_PACKAGE=@anthropic-ai/claude-code-linux-arm64 ;; \
      *) echo "unsupported Claude Code target arch: ${target_arch}" >&2; exit 1 ;; \
    esac; \
    npm install -g \
      "@openai/codex@${CODEX_VERSION}" \
      "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
      "${CLAUDE_CODE_PLATFORM_PACKAGE}@${CLAUDE_CODE_VERSION}" \
      "opencode-ai@${OPENCODE_VERSION}" \
      "@earendil-works/pi-coding-agent@${PI_AGENT_VERSION}" \
      "pi-mcp-adapter@${PI_MCP_ADAPTER_VERSION}" \
      "@deepseek-ai/dsh@${DSH_VERSION}" && \
    npm cache clean --force && \
    rm -rf /root/.npm

RUN mkdir -p /usr/local/share/jupyter/kernels/javascript /root/.codex /root/.opencode /root/.dsh /root/.local/bin /root/.cargo/bin /workspace /data/state /data/runtime /data/logs

COPY ./assets/.codex/ /root/.codex/
COPY ./assets/.claude/ /root/.claude/
COPY ./assets/.claude.json /root/
COPY ./assets/.gitconfig /root/
COPY ./assets/.dsh/ /root/.dsh/

COPY runtime/jupyter-javascript-kernel/kernel.json /usr/local/share/jupyter/kernels/javascript/kernel.json
COPY runtime/javascript /tmp/agent-compose-runtime
COPY runtime/agent-compose-runtime-sdk /tmp/agent-compose-runtime-sdk

RUN cd /tmp/agent-compose-runtime && \
    npm ci && \
    RUNTIME_TARBALL="$(npm pack --silent | tail -n 1)" && \
    npm install -g "./${RUNTIME_TARBALL}" && \
    npm cache clean --force && \
    rm -rf /root/.npm && \
    rm -rf /tmp/agent-compose-runtime && \
    ln -sfv ../lib/node_modules/@chaitin-ai/agent-compose-runtime/dist/cli.js /usr/bin/agent-compose-runtime && \
    ln -sf ../lib/node_modules/@openai/codex/bin/codex.js /usr/bin/codex && \
    ln -sf ../lib/node_modules/@anthropic-ai/claude-code/bin/claude.exe /usr/bin/claude && \
    ln -sf ../lib/node_modules/opencode-ai/bin/opencode.exe /usr/bin/opencode && \
    ln -sf ../lib/node_modules/@earendil-works/pi-coding-agent/dist/cli.js /usr/bin/pi && \
    ln -sf ../lib/node_modules/@deepseek-ai/dsh/lib/bin.js /usr/bin/dsh && \
    mkdir -p /usr/local/share/agent-compose/pi-mcp-adapter && \
    ln -sf /usr/lib/node_modules/pi-mcp-adapter/index.ts /usr/local/share/agent-compose/pi-mcp-adapter/index.ts && \
    test -f /usr/local/share/agent-compose/pi-mcp-adapter/index.ts && \
    cd / && \
    pi --version && \
    dsh --version && \
    HOME=/root dsh --profile agent-compose --dump-config-schema > /dev/null && \
    printf 'profile smoke\n' > /tmp/dsh-profile-smoke-prompt.txt && \
    printf 'profile smoke context\n' > /tmp/dsh-profile-smoke-context.txt && \
    mkdir -p /tmp/dsh-profile-smoke-sessions && \
    { HOME=/root DSH_PROMPT_FILE=/tmp/dsh-profile-smoke-prompt.txt \
      DSH_SYSTEM_CONTEXT_FILE=/tmp/dsh-profile-smoke-context.txt \
      DSH_SESSION_ROOT=/tmp/dsh-profile-smoke-sessions DSH_SESSION_ID=profile-smoke \
      DSH_MODEL=profile-smoke LLM_API_ENDPOINT=http://127.0.0.1:1/v1 LLM_API_KEY=profile-smoke \
      DSH_WIRE_API=openai-completions \
      timeout 60 dsh --profile agent-compose > /dev/null 2> /tmp/dsh-profile-smoke.err || true; } && \
    if [ -z "$(find /tmp/dsh-profile-smoke-sessions -mindepth 1 -print -quit)" ]; then \
      echo 'STATUS profile smoke: agent-compose-runner did not activate'; cat /tmp/dsh-profile-smoke.err; exit 1; \
    fi && \
    if grep -q '^agent-compose-runner:' /tmp/dsh-profile-smoke.err; then \
      echo 'STATUS profile smoke: agent-compose-runner failed after activation'; cat /tmp/dsh-profile-smoke.err; exit 1; \
    fi && \
    rm -rf /tmp/dsh-profile-smoke-sessions /tmp/dsh-profile-smoke-prompt.txt /tmp/dsh-profile-smoke-context.txt /tmp/dsh-profile-smoke.err

RUN mkdir -p /opt/agent-compose/npm && \
    cd /tmp/agent-compose-runtime-sdk && \
    npm ci && \
    npm run pack:runtime-bundle -- --pack-destination /opt/agent-compose/npm --filename agent-compose-runtime-sdk.tgz && \
    mkdir -p /tmp/agent-compose-runtime-sdk-empty-cache && \
    npm install --offline --cache /tmp/agent-compose-runtime-sdk-empty-cache /opt/agent-compose/npm/agent-compose-runtime-sdk.tgz --prefix /tmp/agent-compose-runtime-sdk-offline-check && \
    node -e "const { runtime } = require('/tmp/agent-compose-runtime-sdk-offline-check/node_modules/@chaitin-ai/agent-compose-runtime-sdk'); if (typeof runtime.shell !== 'function') process.exit(1)" && \
    npm cache clean --force && \
    rm -rf /root/.npm && \
    rm -rf /tmp/agent-compose-runtime-sdk /tmp/agent-compose-runtime-sdk-offline-check /tmp/agent-compose-runtime-sdk-empty-cache

ENV HOME=/root \
    OPENCODE_DISABLE_AUTOUPDATE=true \
    OPENCODE_DISABLE_MODELS_FETCH=1 \
    PATH=/root/.local/bin:/root/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN printf '%s\n' \
  '#!/usr/bin/env bash' \
  'set -euo pipefail' \
  'mkdir -p /root/.codex /root/.opencode /root/.dsh /root/.local/bin /root/.cargo/bin /workspace /data/state /data/runtime /data/logs' \
  'export HOME=${HOME:-/root}' \
  'export OPENCODE_DISABLE_AUTOUPDATE=${OPENCODE_DISABLE_AUTOUPDATE:-true}' \
  'export OPENCODE_DISABLE_MODELS_FETCH=${OPENCODE_DISABLE_MODELS_FETCH:-1}' \
  'export PATH=/root/.local/bin:/root/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' \
  'exec "$@"' > /usr/local/bin/agent-compose-env && chmod +x /usr/local/bin/agent-compose-env

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/agent-compose-env", "bash", "-lc", "sleep infinity"]
